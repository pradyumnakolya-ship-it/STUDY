# StudyGPT Backend — Environment Variables (Free Tier & Lightweight Models)
# Copy this file to backend/.env and fill in your API key(s)

# ── 1. Google Gemini API Key (Recommended - Free Tier Available) ──────────────
# Get your FREE API key at: https://aistudio.google.com/apikey
# Free tier models: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-flash-8b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ── 1b. Multi-Key Pool for Production (Optional) ─────────────────────────────
# Comma-separated list of API keys for round-robin rotation to bypass quota limits.
# Create multiple keys on Google AI Studio using separate Google accounts.
# When set, the backend will rotate across all keys automatically.
# GEMINI_API_KEYS=AIzaSy...key1,AIzaSy...key2,AIzaSy...key3
GEMINI_API_KEYS=

# Get your API key at: https://platform.openai.com/api-keys
# Lightweight/Free-credit model: gpt-4o-mini, gpt-3.5-turbo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── 3. Anthropic Claude API Key ───────────────────────────────────────────────
# Get your API key at: https://console.anthropic.com/
# Lightweight/Haiku model: claude-3-5-haiku-20241022, claude-3-haiku-20240307
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ── 4. xAI Grok API Key ───────────────────────────────────────────────────────
# Get your API key at: https://console.x.ai/
# Beta/Fast model: grok-beta, grok-2-latest
XAI_API_KEY=
GROK_MODEL=grok-beta

# ── Database & Auth (Optional / Local Defaults) ────────────────────────────────
MONGO_URL=mongodb://localhost:27017
MONGO_DB=studygpt
JWT_SECRET=super-secret-studygpt-jwt-key-2026-change-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080
