# StudyGPT Backend — Environment Variables
# Copy this file to .env and fill in your values

# Google Gemini API Key
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (ChatGPT: gpt-4o, gpt-4o-mini)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic API Key (Claude: claude-3-5-sonnet, claude-3-5-haiku)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# xAI API Key (Grok: grok-2-latest, grok-beta)
# Get yours at: https://console.x.ai/
XAI_API_KEY=
GROK_MODEL=grok-2-latest
